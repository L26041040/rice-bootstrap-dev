{
  "outputStyle": "老弟",
  "extraKnownMarketplaces": {
    "rice-bootstrap": {
      "source": {
        "source": "github",
        "repo": "L26041040/rice-bootstrap",
        "ref": "v0.1.0"
      }
    }
  },
  "enabledPlugins": {
    "rice@rice-bootstrap": true
  },
  "hooks": {
    "SessionEnd": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/archive_session.py\"",
            "timeout": 60,
            "statusMessage": "Archiving session history..."
          }
        ]
      }
    ]
  }
}
